# Safety label used by database-backed verification. Keep this as development locally.
DATABASE_ENVIRONMENT="development"

# Supabase DEVELOPMENT pooled runtime connection (port 6543; append ?pgbouncer=true if required).
# DATABASE_URL and DIRECT_URL must belong to the same development Supabase project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# The same Supabase DEVELOPMENT project's direct connection, used by Prisma migrations/admin operations (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Server-only Supabase CA certificate for hosts that cannot use NODE_EXTRA_CA_CERTS.
# Keep the full PEM value in the deployment provider's encrypted environment storage.
SUPABASE_CA_CERT=""

# Initial administrator; used only by `pnpm db:seed`.
SEED_ADMIN_NAME="Startek Administrator"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Sessions are opaque random tokens stored as hashes, so no session signing secret is required.
# Never prefix server secrets with NEXT_PUBLIC_.
