generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  DESIGNER
  PRODUCTION
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InvoiceStatus {
  FINALIZED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  QR
}

enum ExpenseCategory {
  MATERIALS
  ELECTRICITY
  SALARY
  TRANSPORT
  MAINTENANCE
  RENT
  PETTY_CASH
  OTHER
}

enum ExpenseStatus {
  FINALIZED
  VOID
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_DEPOSIT
  CASH_WITHDRAWAL
}

enum QuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum OrderStatus {
  PENDING
  DESIGNING
  WAITING_APPROVAL
  APPROVED
  PRINTING
  FINISHING
  READY
  DELIVERED
  CANCELLED
}

model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String                   @unique
  passwordHash           String
  role                   Role
  status                 UserStatus               @default(ACTIVE)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  sessions               Session[]
  auditLogs              AuditLog[]
  invoicesCreated        Invoice[]                @relation("InvoiceCreatedBy")
  invoicesVoided         Invoice[]                @relation("InvoiceVoidedBy")
  paymentsRecorded       Payment[]                @relation("PaymentRecordedBy")
  reversalsRecorded      PaymentReversal[]        @relation("ReversalRecordedBy")
  expensesCreated        Expense[]                @relation("ExpenseCreatedBy")
  expensesVoided         Expense[]                @relation("ExpenseVoidedBy")
  cashSessionsOpened     CashSession[]            @relation("CashSessionOpenedBy")
  cashSessionsClosed     CashSession[]            @relation("CashSessionClosedBy")
  cashMovementsCreated   CashMovement[]
  quotationsCreated      Quotation[]              @relation("QuotationCreatedBy")
  quotationsConverted    Quotation[]              @relation("QuotationConvertedBy")
  quotationStatusChanges QuotationStatusHistory[]
  ordersCreated          Order[]                  @relation("OrderCreatedBy")
  ordersAssigned         Order[]                  @relation("OrderAssignedTo")
  orderStatusChanges     OrderStatusHistory[]

  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Setting {
  id                String   @id @default("primary")
  businessName      String   @default("Startek Print Hub")
  address           String   @default("No.62 Padukka Road, Meegoda")
  phonePrimary      String   @default("0705935320")
  phoneSecond       String   @default("0777250493")
  email             String   @default("startekprinthub@gmail.com")
  currencyCode      String   @default("LKR")
  displayCurrency   String   @default("Rs.")
  timeZone          String   @default("Asia/Colombo")
  receiptWidth      String   @default("80mm")
  printerModel      String   @default("Xprinter XP-80T")
  printerConnection String   @default("USB")
  receiptFooter     String   @default("Design & Deploy by Startek (PVT) LTD")
  invoicePrefix     String   @default("SPH-INV")
  orderPrefix       String   @default("SPH-ORD")
  quotePrefix       String   @default("SPH-QT")
  expensePrefix     String   @default("SPH-EXP")
  operationalDataStartAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("settings")
}

model NumberCounter {
  key       String   @id
  nextValue BigInt   @default(1)
  updatedAt DateTime @updatedAt

  @@map("number_counters")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Customer {
  id          String      @id @default(cuid())
  name        String
  phoneNumber String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  invoices    Invoice[]
  quotations  Quotation[]
  orders      Order[]

  @@map("customers")
}

model Invoice {
  id                    String        @id @default(cuid())
  invoiceNumber         String        @unique
  idempotencyKey        String        @unique
  customerId            String?
  customerNameSnapshot  String?
  customerPhoneSnapshot String?
  subtotal              Decimal       @db.Decimal(18, 2)
  discount              Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal       @db.Decimal(18, 2)
  status                InvoiceStatus @default(FINALIZED)
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  voidedAt              DateTime?
  voidedById            String?
  voidReason            String?
  orderId               String?       @unique
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy             User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy              User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items                 InvoiceItem[]
  payments              Payment[]
  order                 Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerNameSnapshot])
  @@index([customerPhoneSnapshot])
  @@map("invoices")
}

model Quotation {
  id                    String                   @id @default(cuid())
  quotationNumber       String                   @unique
  idempotencyKey        String                   @unique
  customerId            String?
  customerNameSnapshot  String
  customerPhoneSnapshot String
  subtotal              Decimal                  @db.Decimal(18, 2)
  discount              Decimal                  @default(0) @db.Decimal(18, 2)
  grandTotal            Decimal                  @db.Decimal(18, 2)
  status                QuotationStatus          @default(DRAFT)
  notes                 String?
  validUntil            DateTime?                @db.Date
  createdById           String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  convertedAt           DateTime?
  convertedById         String?
  customer              Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy             User                     @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  convertedBy           User?                    @relation("QuotationConvertedBy", fields: [convertedById], references: [id], onDelete: Restrict)
  items                 QuotationItem[]
  statusHistory         QuotationStatusHistory[]
  order                 Order?

  @@index([customerId])
  @@index([status, createdAt])
  @@index([customerNameSnapshot])
  @@index([customerPhoneSnapshot])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal   @db.Decimal(18, 3)
  unitPrice   Decimal   @db.Decimal(18, 2)
  lineTotal   Decimal   @db.Decimal(18, 2)
  sortOrder   Int
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  @@unique([quotationId, sortOrder])
  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationStatusHistory {
  id             String           @id @default(cuid())
  quotationId    String
  previousStatus QuotationStatus?
  newStatus      QuotationStatus
  note           String?
  changedById    String
  createdAt      DateTime         @default(now())
  quotation      Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  changedBy      User             @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([quotationId, createdAt])
  @@map("quotation_status_history")
}

model Order {
  id                    String               @id @default(cuid())
  orderNumber           String               @unique
  quotationId           String?              @unique
  customerId            String?
  customerNameSnapshot  String
  customerPhoneSnapshot String
  status                OrderStatus          @default(PENDING)
  jobName               String?
  dueDate               DateTime?            @db.Date
  assignedStaffId       String?
  notes                 String?
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  quotation             Quotation?           @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedStaff         User?                @relation("OrderAssignedTo", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy             User                 @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  invoice               Invoice?

  @@index([customerId])
  @@index([status, dueDate])
  @@index([assignedStaffId, status])
  @@index([customerNameSnapshot])
  @@index([customerPhoneSnapshot])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  description        String
  quantity           Decimal  @db.Decimal(18, 3)
  unitPrice          Decimal  @db.Decimal(18, 2)
  lineTotal          Decimal  @db.Decimal(18, 2)
  size               String?
  material           String?
  finishing          String?
  designInstructions String?
  additionalNotes    String?
  sortOrder          Int
  createdAt          DateTime @default(now())
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, sortOrder])
  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  changedById    String
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy      User         @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  sortOrder   Int
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, sortOrder])
  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String           @id @default(cuid())
  invoiceId     String
  amount        Decimal          @db.Decimal(18, 2)
  method        PaymentMethod
  reference     String?
  recordedById  String
  cashSessionId String?
  cashTendered  Decimal?         @db.Decimal(18, 2)
  changeGiven   Decimal?         @db.Decimal(18, 2)
  createdAt     DateTime         @default(now())
  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy    User             @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  cashSession   CashSession?     @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  reversal      PaymentReversal?

  @@index([invoiceId, createdAt])
  @@index([method, createdAt])
  @@index([cashSessionId, createdAt])
  @@map("payments")
}

model PaymentReversal {
  id           String   @id @default(cuid())
  paymentId    String   @unique
  reason       String
  reversedById String
  createdAt    DateTime @default(now())
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversedBy   User     @relation("ReversalRecordedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([reversedById, createdAt])
  @@map("payment_reversals")
}

model Expense {
  id             String          @id @default(cuid())
  expenseNumber  String          @unique
  idempotencyKey String          @unique
  expenseDate    DateTime        @default(now())
  category       ExpenseCategory
  description    String
  amount         Decimal         @db.Decimal(18, 2)
  paymentMethod  PaymentMethod
  status         ExpenseStatus   @default(FINALIZED)
  createdById    String
  cashSessionId  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdBy      User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy       User?           @relation("ExpenseVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  cashSession    CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([category, expenseDate])
  @@index([paymentMethod, expenseDate])
  @@index([status, expenseDate])
  @@index([createdById, expenseDate])
  @@index([cashSessionId, expenseDate])
  @@map("expenses")
}

model CashSession {
  id                  String            @id @default(cuid())
  idempotencyKey      String            @unique
  closeIdempotencyKey String?           @unique
  openGuard           String?           @unique
  openingCash         Decimal           @db.Decimal(18, 2)
  status              CashSessionStatus @default(OPEN)
  openedAt            DateTime          @default(now())
  openedById          String
  closedAt            DateTime?
  closedById          String?
  expectedCash        Decimal?          @db.Decimal(18, 2)
  actualCash          Decimal?          @db.Decimal(18, 2)
  difference          Decimal?          @db.Decimal(18, 2)
  closingNote         String?
  openedBy            User              @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy            User?             @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  payments            Payment[]
  expenses            Expense[]
  movements           CashMovement[]

  @@index([status, openedAt])
  @@index([openedById, openedAt])
  @@index([closedById, closedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id             String           @id @default(cuid())
  idempotencyKey String           @unique
  cashSessionId  String
  type           CashMovementType
  amount         Decimal          @db.Decimal(18, 2)
  reason         String
  createdById    String
  createdAt      DateTime         @default(now())
  cashSession    CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([cashSessionId, createdAt])
  @@index([createdById, createdAt])
  @@map("cash_movements")
}
